<configuration name="sofia.conf" description="rig load SIP">
  <global_settings>
    <param name="log-level" value="0"/>
  </global_settings>
  <profiles>
    <profile name="internal">
      <settings>
        <param name="sip-ip" value="$${local_ip_v4}"/>
        <param name="rtp-ip" value="$${local_ip_v4}"/>
        <param name="sip-port" value="5060"/>
        <param name="context" value="load"/>
        <param name="dialplan" value="XML"/>
        <param name="auth-calls" value="false"/>
        <param name="accept-blind-reg" value="true"/>
        <param name="inbound-codec-prefs" value="PCMA,PCMU"/>
        <param name="outbound-codec-prefs" value="PCMA,PCMU"/>
        <param name="inbound-codec-negotiation" value="generous"/>
        <!-- SIPp's pcap player sends no RTP between plays; the stock 300 s
             timeout would tear long soak calls down mid-run. -->
        <param name="rtp-timeout-sec" value="0"/>
        <param name="disable-transcoding" value="false"/>
      </settings>
    </profile>
  </profiles>
</configuration>
