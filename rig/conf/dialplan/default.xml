<include>
  <context name="default">
    <!-- Deterministic audio source for the rig: a continuous tone means the mock
         server can assert on byte counts instead of "some audio arrived". -->
    <extension name="rig-tone">
      <condition field="destination_number" expression="^rig-tone$">
        <action application="answer"/>
        <action application="playback" data="tone_stream://%(600000,0,350,440);loops=-1"/>
      </condition>
    </extension>

    <!-- Fork started from the dialplan, the drop-in path an existing drachtio
         deployment would migrate to. -->
    <extension name="rig-fork">
      <condition field="destination_number" expression="^rig-fork$">
        <action application="answer"/>
        <action application="set" data="api_result=${uuid_audio_fork(${uuid} start ws://mock-ws:9099/ mono 16000)}"/>
        <action application="playback" data="tone_stream://%(600000,0,350,440);loops=-1"/>
      </condition>
    </extension>
  </context>
</include>
