<!-- Install as conf/autoload_configs/audio_fork.conf.xml: switch_xml_open_cfg
     only finds it there, and a file left at the conf root is silently ignored
     (the module then runs on defaults). -->
<configuration name="audio_fork.conf" description="mod_audio_fork">
  <settings>
    <!-- 0 = one shard per CPU core, capped at 16 -->
    <param name="shard-count" value="0"/>

    <!-- outbound audio held per fork before the oldest is dropped -->
    <param name="send-buffer-seconds" value="10"/>

    <!-- audio per websocket message; larger means fewer syscalls, more latency -->
    <param name="coalesce-max-ms" value="100"/>

    <!-- ceiling for all fork buffers together; new forks are refused and
         stalled forks degrade rather than letting FreeSWITCH be OOM-killed -->
    <param name="global-memory-cap-mb" value="1536"/>

    <!-- playback (server -> caller): above the high watermark the module stops
         reading the socket so the server's audio waits in TCP rather than in
         our memory; reading resumes below the low watermark -->
    <param name="playback-high-watermark-ms" value="10000"/>
    <param name="playback-low-watermark-ms" value="2000"/>

    <param name="reconnect-backoff-min-ms" value="250"/>
    <param name="reconnect-backoff-max-ms" value="5000"/>

    <param name="max-forks-per-call" value="4"/>

    <!-- wss:// trust. An empty ca-file uses the OS trust store; cert and key
         are the client certificate for mTLS and are set together or not at all -->
    <param name="tls-ca-file" value=""/>
    <param name="tls-cert-file" value=""/>
    <param name="tls-key-file" value=""/>

    <!-- off accepts any server certificate, including self-signed and expired,
         and skips the hostname check: test rigs only -->
    <param name="tls-verify" value="true"/>
  </settings>
</configuration>
