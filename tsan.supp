# lws_cancel_service is libwebsockets' one documented thread-safe entry point:
# its cross-thread wake-up is synchronized by a pipe write (a syscall), which is
# real synchronization TSan's memory model cannot see. Everything else in lws
# runs single-threaded on its owning shard, so no other lws frame is suppressed.
race:lws_cancel_service

# lws lifecycle tagging (__lws_lc_tag/_untag) updates a global object-count
# list used only for log decoration; two independent lws contexts freeing wsis
# on their own threads race on those counters. Worst case is a wrong count in
# a log line — never protocol or connection state.
race:__lws_lc_tag
race:__lws_lc_untag
